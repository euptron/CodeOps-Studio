<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item
        android:color="@android:color/transparent"
        android:state_activated="true" />
    <!-- Checked. -->
    <!-- Uses the on surface state layer since tapping a checked selection control
        will turn it to the unchecked color. -->
    <item
        android:alpha="@dimen/ripple_pressed_alpha"
        android:color="?attr/colorOnSurface"
        android:state_pressed="true"
        android:state_checked="true" />
    <item
        android:alpha="@dimen/ripple_focused_alpha"
        android:color="?attr/colorPrimary"
        android:state_focused="true"
        android:state_checked="true" />
    <item
        android:alpha="@dimen/ripple_hovered_alpha"
        android:color="?attr/colorPrimary"
        android:state_hovered="true"
        android:state_checked="true" />
    <item
        android:alpha="@dimen/ripple_default_alpha"
        android:color="?attr/colorPrimary"
        android:state_checked="true" />

    <!-- Unchecked. -->
    <!-- Uses the primary state layer since tapping an unchecked selection
        control will turn it to the checked color. -->
    <item
        android:alpha="@dimen/ripple_pressed_alpha"
        android:color="?attr/colorPrimary"
        android:state_pressed="true" />
    <item
        android:alpha="@dimen/ripple_focused_alpha"
        android:color="?attr/colorOnSurface"
        android:state_focused="true" />
    <item
        android:alpha="@dimen/ripple_hovered_alpha"
        android:color="?attr/colorOnSurface"
        android:state_hovered="true" />
    <item
        android:alpha="@dimen/ripple_default_alpha"
        android:color="?attr/colorOnSurface" />

</selector>