<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="@dimen/dimen4dp">

    <ImageView
        android:id="@+id/tab_icon"
        android:layout_width="@dimen/dimen20dp"
        android:layout_height="@dimen/dimen20dp"
        android:layout_gravity="center_vertical"
        android:layout_marginLeft="@dimen/dimen2dp"
        android:layout_marginRight="@dimen/dimen2dp"
        android:contentDescription="@string/tab_icon_desc"
        android:scaleType="centerInside"
        android:visibility="gone"
        tools:src="@drawable/ic_codeopsstudio" />

    <TextView
        android:id="@+id/tab_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:layout_marginLeft="@dimen/dimen1dp"
        android:layout_marginRight="@dimen/dimen1dp"
        android:layout_weight="1"
        android:gravity="center"
        android:maxLines="1"
        android:textSize="@dimen/dimen12sp"
        tools:text="Tab Title" />

    <ImageButton
        android:id="@+id/pane_action_button"
        android:layout_width="@dimen/dimen16dp"
        android:layout_height="@dimen/dimen16dp"
        android:layout_gravity="center"
        android:layout_marginLeft="@dimen/dimen2dp"
        android:layout_marginRight="@dimen/dimen2dp"
        android:background="@android:color/transparent"
        android:contentDescription="@string/pane_action_button_desc"
        android:scaleType="fitXY"
        android:visibility="invisible"
        tools:src="@drawable/ic_window_close" />

</LinearLayout>
