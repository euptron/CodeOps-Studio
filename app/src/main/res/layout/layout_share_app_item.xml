<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/dimen8dp"
    android:layout_marginBottom="@dimen/dimen8dp"
    android:orientation="vertical"
    tools:theme="@style/AppTheme">

    <com.google.android.material.divider.MaterialDivider
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:layout_marginTop="@dimen/dimen12dp"
        android:layout_marginBottom="@dimen/dimen8dp"
        android:alpha="0.8" />

    <com.eup.libraries.sharelayout.ShareLayout
        android:id="@+id/share_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="?android:attr/listPreferredItemPaddingStart"
        android:paddingLeft="?android:attr/listPreferredItemPaddingLeft"
        android:paddingEnd="?android:attr/listPreferredItemPaddingEnd"
        android:paddingRight="?android:attr/listPreferredItemPaddingRight"
        app:promptTextAppearance="?textAppearanceLabelSmall"
        app:shareActionsCornerRadius="15dp"
        app:shareButtonText="@string/sharelayout_actiontext"
        app:shareLayoutColor="@color/miui_sharelayout_color"
        app:showProgressBar="false"
        app:summaryText="@string/sharelayout_summarytext"
        app:summaryTextAppearance="?android:attr/textAppearanceSmall"
        app:titleText="@string/sharelayout_titletext"
        app:titleTextAppearance="?android:attr/textAppearanceListItem" />

    <com.google.android.material.divider.MaterialDivider
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:layout_marginTop="@dimen/dimen18dp"
        android:layout_marginBottom="@dimen/dimen1dp"
        android:alpha="0.8" />

</LinearLayout>
