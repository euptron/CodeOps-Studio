<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="4dp"
    android:background="?attr/selectableItemBackground">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/iv_plugin_thumbnail"
            android:layout_width="@dimen/dimen42dp"
            android:layout_height="@dimen/dimen42dp"
            android:scaleType="centerCrop"
            android:layout_alignParentStart="true"
            android:contentDescription="Plugin Thumbnail" />

        <ImageButton
            android:id="@+id/iv_btn_more"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_more"
            android:contentDescription="Menu Options" />

        <TextView
            android:id="@+id/tv_plugin_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/iv_plugin_thumbnail"
            android:layout_toStartOf="@id/iv_btn_more"
            android:layout_alignTop="@id/iv_plugin_thumbnail"
            android:text="Plugin Name"
            android:textSize="12sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="4dp" />

        <TextView
            android:id="@+id/tv_plugin_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/tv_plugin_name"
            android:layout_toEndOf="@id/iv_plugin_thumbnail"
            android:layout_toStartOf="@id/iv_btn_more"
            android:text="Plugin description"
            android:textSize="10sp"
            android:includeFontPadding="false"
            android:maxLines="2"
            android:ellipsize="end"
            android:layout_marginTop="2dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="4dp" />
    </RelativeLayout>
    
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="2dp">

        <TextView
            android:id="@+id/btn_avg_star_rating"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="4.5"
            android:textSize="10sp"
            android:gravity="center"
            android:layout_marginEnd="2dp" />

        <ImageView
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:src="@drawable/ic_star"
            android:layout_gravity="center"
            android:layout_marginEnd="6dp" />

        <TextView
            android:id="@+id/btn_download_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="33"
            android:textSize="10sp"
            android:gravity="center"
            android:layout_marginEnd="2dp" />
        
        <ImageView
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:src="@drawable/ic_deployed_code_update"
            android:tint="?android:attr/textColorSecondary"
            android:layout_marginEnd="6dp" />
            
        <TextView
            android:id="@+id/btn_publisher"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@euptron"
            android:textColor="?attr/colorPrimary"
            android:textSize="10sp"
            android:gravity="center"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>
</LinearLayout>
